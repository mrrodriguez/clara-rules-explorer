# 1. Validation for Node.js (Min version 24)
if command -v node >/dev/null 2>&1; then
  NODE_MAJOR=$(node -v | tr -d 'v' | cut -d. -f1)
  if [ "$NODE_MAJOR" -lt 24 ]; then
    echo "⚠️  Warning: Node 24+ is required. Found $(node -v)"
  fi
else
  echo "❌ Error: Node.js is not active. Please ensure it is managed by your environment (e.g. mise)."
fi

# 2. Validation for pnpm (Min version 10.4.1)
if command -v pnpm >/dev/null 2>&1; then
  PNPM_VERSION=$(pnpm -v)
  PNPM_MAJOR=$(echo "$PNPM_VERSION" | cut -d. -f1)
  PNPM_MINOR=$(echo "$PNPM_VERSION" | cut -d. -f2)
  PNPM_PATCH=$(echo "$PNPM_VERSION" | cut -d. -f3)

  IS_MIN_VERSION=true
  if [ "$PNPM_MAJOR" -lt 10 ]; then
    IS_MIN_VERSION=false
  elif [ "$PNPM_MAJOR" -eq 10 ]; then
    if [ "$PNPM_MINOR" -lt 4 ]; then
      IS_MIN_VERSION=false
    elif [ "$PNPM_MINOR" -eq 4 ]; then
      if [ "$PNPM_PATCH" -lt 1 ]; then
        IS_MIN_VERSION=false
      fi
    fi
  fi

  if [ "$IS_MIN_VERSION" = false ]; then
    echo "⚠️  Warning: pnpm 10.4.1+ is required. Found $PNPM_VERSION"
  fi
else
  echo "❌ Error: pnpm is not active. Please ensure it is managed by your environment (e.g. mise)."
fi

# Load local-only environment variables if available
if [ -f .envrc.local ]; then
  source_env .envrc.local
fi
