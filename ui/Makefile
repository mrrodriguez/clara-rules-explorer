# Clara Rules Explorer UI — quality, test, and cross-project convenience
# targets, mirroring ../server/Makefile on the server side.
#
# `make test-e2e` (and the `test` aggregate) wires up the prerequisites that
# bare `pnpm test:e2e` does not: the serialized demo session
# (server/demo-data/session.bin, gitignored) and installed deps.
.PHONY: test test-unit test-e2e deps demo-setup check lint format format-check clean

SHELL := /bin/bash

SERVER_DIR := $(CURDIR)/../server

# Serialized loan-app-rules session served by the loan-app e2e backend
# (bin/ci/start-loan-app-backend.sh).  Gitignored — generated by the server's
# `make demo-setup`.  Without it the backend exits immediately with
# "Error: session file not found" and Playwright's webServer gives up.
DEMO_SESSION := $(SERVER_DIR)/demo-data/session.bin

# Installed dependencies.  Run `make deps` (or `pnpm install`) explicitly
# after pnpm-lock.yaml changes; the file target below only installs when
# node_modules is missing.
node_modules:
	pnpm install

deps:
	pnpm install

# Build the demo session only when missing (checked as a file prerequisite of
# test-e2e); use `make demo-setup` to regenerate unconditionally.
$(DEMO_SESSION):
	$(MAKE) -C $(SERVER_DIR) demo-setup

# Regenerate the demo session unconditionally (rules changed since last build).
demo-setup:
	$(MAKE) -C $(SERVER_DIR) demo-setup

test: test-unit test-e2e

test-unit: node_modules
	pnpm run test:unit -- --run

test-e2e: node_modules $(DEMO_SESSION)
	pnpm run test:e2e

check: node_modules
	pnpm run check

lint: node_modules
	pnpm run lint

format: node_modules
	pnpm run format

format-check:
	pnpm exec prettier --check src static *.config.js *.config.ts *.config.json package.json tsconfig.json

clean:
	rm -rf build .svelte-kit test-results node_modules/.vite
