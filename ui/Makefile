# Clara Rules Explorer UI — quality, test, and cross-project convenience
# targets, mirroring ../server/Makefile on the server side.
#
# `make test-e2e` (and the `test` aggregate) wires up the prerequisites that
# bare `pnpm test:e2e` does not: the serialized demo session
# (server/demo-data/session.bin, gitignored), the e2e production SPA build,
# and installed deps.
.PHONY: test test-unit test-e2e deps demo-setup demo-scrape demo-preview e2e-build check lint format format-check clean e2e-stop

SHELL := /bin/bash

SERVER_DIR := $(CURDIR)/../server

# Serialized loan-app-rules session served by the loan-app e2e backend
# (bin/ci/start-loan-app-backend.sh).  Gitignored — generated by the server's
# `make demo-setup`.  Without it the backend exits immediately with
# "Error: session file not found" and Playwright's webServer gives up.
DEMO_SESSION := $(SERVER_DIR)/demo-data/session.bin

# Production Node build for e2e tests.  `E2E_BUILD=true` switches
# svelte.config.js to adapter-node (SSR on, /v1 proxied to live backend).
# Tests run against `node build`, not the dev server — faster page loads
# and the build matches what ships (just adapter-node vs adapter-auto).
E2E_BUILD_SENTINEL := build/index.js

# Installed dependencies.  Run `make deps` (or `pnpm install`) explicitly
# after pnpm-lock.yaml changes; the file target below only installs when
# node_modules is missing.
node_modules:
	pnpm install

deps:
	pnpm install

# Build the demo session only when missing (checked as a file prerequisite of
# test-e2e); use `make demo-setup` to regenerate unconditionally.
$(DEMO_SESSION):
	$(MAKE) -C $(SERVER_DIR) demo-setup

# Regenerate the demo session unconditionally (rules changed since last build).
demo-setup:
	$(MAKE) -C $(SERVER_DIR) demo-setup

demo-scrape: deps
	pnpm run scrape:demo

demo-preview:
	pnpm preview

# Build the e2e SPA only when missing.  Use `make e2e-build` to regenerate
# unconditionally (e.g. after source changes).
$(E2E_BUILD_SENTINEL):
	E2E_BUILD=true pnpm exec vite build

# Regenerate the e2e SPA build unconditionally.
e2e-build:
	E2E_BUILD=true pnpm exec vite build

test: test-unit test-e2e

test-unit: node_modules
	pnpm exec vitest --passWithNoTests --run

test-e2e: node_modules $(DEMO_SESSION) $(E2E_BUILD_SENTINEL)
	pnpm run test:e2e

check: node_modules
	pnpm run check

lint: node_modules
	pnpm run lint

format: node_modules
	pnpm run format

format-check:
	pnpm exec prettier --check src static *.config.js *.config.ts *.config.json package.json tsconfig.json

clean:
	rm -rf build .svelte-kit test-results node_modules/.vite
	@echo "Run 'make e2e-build' to regenerate the e2e SPA before the next test-e2e."

# Kill any hanging e2e servers by their saved PIDs.
# Playwright writes each server's PID to .e2e-pids/<name>.pid on startup;
# this reads them back and kills the processes directly — no port scanning.
E2E_PID_DIR := .e2e-pids
e2e-stop:
	@if [ -d "$(E2E_PID_DIR)" ]; then \
		for pidfile in $(E2E_PID_DIR)/*.pid; do \
			[ -f "$$pidfile" ] || continue; \
			pid=$$(cat "$$pidfile"); \
			label=$$(basename "$$pidfile" .pid); \
			if kill -9 $$pid 2>/dev/null; then \
				echo "stopped $$label (pid $$pid)"; \
			else \
				echo "$$label (pid $$pid) already gone"; \
			fi; \
			rm -f "$$pidfile"; \
		done; \
	else \
		echo "no pid files found in $(E2E_PID_DIR)"; \
	fi
