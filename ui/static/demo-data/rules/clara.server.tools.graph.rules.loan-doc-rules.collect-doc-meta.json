{
	"source-rule": true,
	"ns": "clara.server.tools.graph.rules.loan-doc-rules",
	"name": "clara.server.tools.graph.rules.loan-doc-rules/collect-doc-meta",
	"lhs-types": [
		"clara.server.tools.graph.rules.loan_app_facts.Application",
		"clara.server.tools.graph.rules.loan_app_facts.GivenDocument",
		"extract-doc-meta"
	],
	"lhs": [
		{
			"type": "clara.server.tools.graph.rules.loan_app_facts.Application",
			"constraints": "[\n(= ?app-id app-id)\n]"
		},
		{
			"accumulator": ["clara.rules.accumulators/all"],
			"from": {
				"type": "clara.server.tools.graph.rules.loan_app_facts.GivenDocument",
				"constraints": "[\n(= ?app-id app-id)\n]"
			},
			"result-binding": "?docs"
		},
		{
			"type": "extract-doc-meta",
			"constraints": "[\n]",
			"fact-binding": "?extract-doc-meta"
		}
	],
	"retract-types": [],
	"notes": null,
	"annotation-sources": ["clara-rules/insert-types"],
	"insert-types": ["clara.server.tools.graph.rules.loan_app_facts.AllGivenDocumentsMeta"],
	"rhs-form": "(do\n (let\n  [doc-metas (mapv ?extract-doc-meta ?docs)]\n  (r/insert!\n   (laf/map->AllGivenDocumentsMeta\n    {:app-id ?app-id, :doc-metas doc-metas}))))\n",
	"doc": null,
	"sink-rule": true,
	"props": {}
}
