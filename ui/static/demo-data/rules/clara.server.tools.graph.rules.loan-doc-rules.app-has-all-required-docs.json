	"lhs-types": [
		"clara.server.tools.graph.rules.loan_app_facts.Application",
		"loan-doc-rules/document-check-input"
	],
	"lhs": [
		{
			"type": "clara.server.tools.graph.rules.loan_app_facts.Application",
			"constraints": "[\n(= ?app-id app-id)\n]"
		},
		{
			"type": "loan-doc-rules/document-check-input",
			"constraints": "[\n(= ?app-id app-id)\n\n(= ?required-docs required-docs)\n\n(= ?given-docs given-docs)\n\n(= ?missing-required-docs missing-required-docs)\n]",
			"args": [
				{
					"keys": ["app-id", "required-docs", "given-docs", "missing-required-docs"]
				}
			]
		}
	],
