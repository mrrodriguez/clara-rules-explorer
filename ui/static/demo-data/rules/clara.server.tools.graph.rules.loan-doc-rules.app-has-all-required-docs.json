	],
	"rhs-form": "(do\n (let\n  [status\n   (if (seq ?missing-required-docs) :fail :pass)\n   message\n   (case\n    status\n    :fail\n    \"Missing required documents\"\n    \"All required documents found\")]\n  (r/insert!\n   (laf/map->DocumentCheck\n    {:app-id ?app-id, :status status, :message message}))))\n",
