			"type": "query"
		}
	],
	"dynamic-insert-types-detected": {
		"callsites": [
			{
				"source-str": "(map->ApplicationOutcome {:app-id ?app-id, :status :pending, :message \"Application pending\", :checks-complete checks-complete, :checks-incomplete checks-incomplete})",
				"ns": "clara.server.tools.graph.rules.loan-app-rules",
				"filename": "clara/server/tools/graph/rules/loan_app_rules.clj",
				"status": "full",
				"resolved-types": ["clara.server.tools.graph.rules.loan_app_rules.ApplicationOutcome"]
			}
