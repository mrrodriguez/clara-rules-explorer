{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}
        com.github.gateless/clara-rules {:mvn/version "1.6.7"}
        prismatic/schema {:mvn/version "1.4.1"}
        metosin/reitit {:mvn/version "0.10.1"}
        metosin/jsonista {:mvn/version "1.0.0"}
        metosin/muuntaja {:mvn/version "0.6.11"}
        ring/ring-jetty-adapter {:mvn/version "1.15.4"}
        org.clojure/tools.cli {:mvn/version "1.0.214"}
        clj-kondo/clj-kondo {:mvn/version "2026.05.25"}

        ;; Logging facade (no runtime deps — see :dev for the standalone backend).
        ;; tools.logging auto-detects SLF4J -> commons-logging -> log4j2 ->
        ;; log4j -> java.util.logging, so it never forces a backend onto a
        ;; host project's classpath (no binding collisions when embedded).
        org.clojure/tools.logging {:mvn/version "1.3.1"}}

 :aliases
 {:lint {:extra-deps {clj-kondo/clj-kondo {:mvn/version "2026.05.25"}}
         :main-opts ["-m" "clj-kondo.main"]}

  :test {:extra-paths ["test" "test-resources"]
         :extra-deps {ring/ring-mock {:mvn/version "0.6.2"}
                      clj-http/clj-http {:mvn/version "3.13.1"}
                      fipp/fipp {:mvn/version "0.6.29"}}}

  :dev {:extra-paths ["dev" "test-resources"]
        :extra-deps {vvvvalvalval/scope-capture {:mvn/version "0.3.3"}
                     io.github.tonsky/clj-reload {:mvn/version "1.0.0"}
                     ch.qos.logback/logback-classic {:mvn/version "1.6.2"}}}

  ;; Mirror the clj-kondo-generated `.clj-kondo/imports` (clara-rules hooks)
  ;; onto the classpath resources path the analyzer materializes at runtime.
  ;;   clojure -X:sync-kondo-config                                                    ; sync
  ;;   clojure -X:sync-kondo-config clara.server.tools.graph.kondo-config-sync/check   ; verify
  :sync-kondo-config {:extra-paths ["dev"]
                      :exec-fn clara.server.tools.graph.kondo-config-sync/sync!}

  :demo-setup {:extra-paths ["dev" "test" "test-resources"]
               :extra-deps {ch.qos.logback/logback-classic {:mvn/version "1.6.2"}}
               :main-opts ["-m" "clara.server.graph.demo-setup"]}

  :demo-run {:extra-paths ["dev" "test" "test-resources"]
             :extra-deps {ch.qos.logback/logback-classic {:mvn/version "1.6.2"}}
             :main-opts ["-m" "clara.server.graph.demo-run"]}

  :hierarchy-run {:extra-paths ["dev" "test" "test-resources"]
                  :extra-deps {ch.qos.logback/logback-classic {:mvn/version "1.6.2"}}
                  :main-opts ["-m" "clara.server.graph.hierarchy-run"]}

  :run-tests {:extra-paths ["dev" "test" "test-resources"]
              :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
              :main-opts ["-m" "cognitect.test-runner" "-d" "test"]}}}
