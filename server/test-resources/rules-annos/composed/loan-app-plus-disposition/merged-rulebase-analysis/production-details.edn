{"clara.server.tools.graph.rules.loan-app-rules/app-outcome-approved-args-demo" {:notes nil,
  :rhs-form "(do (println (str \"Args demo: app \" ?app-id \" is approved\")))\n",
  :doc "Demonstrates LHS args destructuring — approved outcome with destructured fields.",
  :props {}},
 "clara.server.tools.graph.rules.loan-app-rules/app-outcome-approved?" {:notes nil,
  :rhs-form "(do\n (r/insert!\n  (map->ApplicationOutcome\n   {:app-id ?app-id,\n    :status :approved,\n    :message \"Application approved\",\n    :passed-checks [{:check-type :document} {:check-type :identity} {:check-type :fraud}]})))\n",
  :doc nil,
  :props {"insert-types" ["clara.server.tools.graph.rules.loan_app_rules.ApplicationOutcome"]}},
 "clara.server.tools.graph.rules.loan-app-rules/app-outcome-denied?" {:notes nil,
  :rhs-form "(do\n (let\n  [all-checks\n   [{:check-type :document, :status ?doc-check-status}\n    {:check-type :identity, :status ?identity-check-status}\n    {:check-type :fraud, :status ?fraud-check-status}]\n   passed-checks\n   (into [] (comp (filter (comp #{:pass} :status)) (map :check-type)) all-checks)\n   failed-checks\n   (into [] (comp (remove (comp #{:pass} :status)) (map :check-type)) all-checks)]\n  (r/insert!\n   (map->ApplicationOutcome\n    {:app-id ?app-id,\n     :status :denied,\n     :message \"Application denied\",\n     :passed-checks passed-checks,\n     :failed-checks failed-checks}))))\n",
  :doc nil,
  :props {"insert-types" ["clara.server.tools.graph.rules.loan_app_rules.ApplicationOutcome"]}},
 "clara.server.tools.graph.rules.loan-app-rules/app-outcome-pending?" {:notes nil,
  :rhs-form "(do\n (let\n  [all-checks\n   [{:check-type :document, :complete? (boolean (seq ?doc-checks))}\n    {:check-type :identity, :complete? (boolean (seq ?id-checks))}\n    {:check-type :fraud, :complete? (boolean (seq ?fraud-checks))}]\n   checks-complete\n   (into [] (comp (filter :complete?) (map :check-type)) all-checks)\n   checks-incomplete\n   (into [] (comp (remove :complete?) (map :check-type)) all-checks)]\n  (r/insert!\n   (map->ApplicationOutcome\n    {:app-id ?app-id,\n     :status :pending,\n     :message \"Application pending\",\n     :checks-complete checks-complete,\n     :checks-incomplete checks-incomplete}))))\n",
  :doc nil,
  :props {"insert-types" ["clara.server.tools.graph.rules.loan_app_rules.ApplicationOutcome"]}},
 "clara.server.tools.graph.rules.loan-app-rules/find-app-outcome" {:params #{"?app-id"},
  :notes nil,
  :doc nil,
  :props {}},
 "clara.server.tools.graph.rules.loan-doc-queries/find-document-checks" {:params #{"?app-id"},
  :notes nil,
  :doc "Document checks recorded for an application.",
  :props {}},
 "clara.server.tools.graph.rules.loan-doc-rules/app-has-all-required-docs" {:notes nil,
  :rhs-form "(do\n (let\n  [status\n   (if (seq ?missing-required-docs) :fail :pass)\n   message\n   (case status :fail \"Missing required documents\" \"All required documents found\")]\n  (r/insert! (laf/map->DocumentCheck {:app-id ?app-id, :status status, :message message}))))\n",
  :doc nil,
  :props {}},
 "clara.server.tools.graph.rules.loan-doc-rules/collect-all-missing-required-docs" {:notes nil,
  :rhs-form "(do (swap! count-atom inc))\n",
  :doc nil,
  :props {}},
 "clara.server.tools.graph.rules.loan-doc-rules/collect-app-doc-check-input" {:notes nil,
  :rhs-form "(do\n (let\n  [given-doc-types (into #{} (map :doc-type) ?given-docs)]\n  (insert-document-check-input!\n   {:app-id ?app-id,\n    :required-docs ?required-docs,\n    :given-docs ?given-docs,\n    :missing-required-docs (into [] (remove (comp given-doc-types :doc-type)) ?required-docs)})))\n",
  :doc nil,
  :props {}},
 "clara.server.tools.graph.rules.loan-doc-rules/collect-app-given-docs" {:notes nil,
  :rhs-form "(do (r/insert! (laf/map->AllGivenDocuments {:app-id ?app-id, :docs ?docs})))\n",
  :doc nil,
  :props {}},
 "clara.server.tools.graph.rules.loan-doc-rules/collect-app-id-card-given-docs" {:notes nil,
  :rhs-form "(do (r/insert! (map->AllIdCardGivenDocuments {:app-id ?app-id, :docs ?docs})))\n",
  :doc nil,
  :props {}},
 "clara.server.tools.graph.rules.loan-doc-rules/collect-app-req-docs" {:notes nil,
  :rhs-form "(do (r/insert! (laf/map->AllRequiredDocuments {:app-id ?app-id, :docs ?docs})))\n",
  :doc nil,
  :props {}},
 "clara.server.tools.graph.rules.loan-doc-rules/collect-doc-meta" {:notes nil,
  :rhs-form "(do\n (let\n  [doc-metas (mapv ?extract-doc-meta ?docs)]\n  (r/insert! (laf/map->AllGivenDocumentsMeta {:app-id ?app-id, :doc-metas doc-metas}))))\n",
  :doc nil,
  :props {}},
 "clara.server.tools.graph.rules.loan-doc-rules/doc-check-count" {:notes nil,
  :rhs-form "(do (r/insert! (with-meta {:count ?count} {:type :doc-check-count})))\n",
  :doc nil,
  :props {"insert-types" [:doc-check-count]}},
 "clara.server.tools.graph.rules.loan-doc-rules/doc-check-count-satisfies-min" {:notes nil,
  :rhs-form "(do (r/insert! (with-meta {:count ?count} {:type :doc-check-count-satisfies-min})))\n",
  :doc nil,
  :props {"insert-types" [:doc-check-count-satisfies-min]}},
 "clara.server.tools.graph.rules.loan-doc-rules/dynamic-insert-audit-trail" {:notes nil,
  :rhs-form "(do (r/insert! (build-audit-trail-entry ?app-id :doc-check-passed)))\n",
  :doc "After document checks pass, write an audit trail entry via opaque builder.\n   The analyzer detects an insert but cannot resolve the fact type — the\n   builder is a custom non-record function. This stays unresolved.",
  :props {}},
 "clara.server.tools.graph.rules.loan-doc-rules/dynamic-insert-compliance-metadata" {:notes nil,
  :rhs-form "(do (r/insert! (build-compliance-via-metadata ?app-id)))\n",
  :doc "Same compliance review, but built via metadata-map style.\n   The analyzer captures the with-meta form as a dynamic callsite.",
  :props {}},
 "clara.server.tools.graph.rules.loan-doc-rules/dynamic-insert-compliance-review" {:notes nil,
  :rhs-form "(do (r/insert! (build-compliance-review ?app-id)))\n",
  :doc "After document checks pass, trigger a compliance review via Java constructor.\n   The analyzer sees the ComplianceReview. call but cannot statically determine\n   its return type — captured as a dynamic insert callsite.",
  :props {}},
 "clara.server.tools.graph.rules.loan-doc-rules/dynamic-retract-stale-notice" {:notes nil,
  :rhs-form "(do (r/retract! (StaleDocumentNotice. ?app-id :paystub \"no-longer-needed\")))\n",
  :doc "When doc check passes, retract any stale-document notice via Java constructor.\n   The analyzer captures the retract callsite with source coordinates.",
  :props {}},
 "clara.server.tools.graph.rules.loan-doc-rules/extract-doc-meta-rule" {:notes nil,
  :rhs-form "(do\n (clojure.core/let\n  [resolved__48894__auto__ (var extract-doc-meta)]\n  (clara.rules/insert! resolved__48894__auto__)))\n",
  :doc nil,
  :props {}},
