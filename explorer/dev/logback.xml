<configuration>
  <!-- Standalone logging backend for the explorer server. Lives under dev/
       so it is only on the classpath via the :dev/:demo-setup/:demo-run/
       :hierarchy-run aliases — never shipped as part of the library's base
       classpath, so it cannot collide with a host project's logback config. -->
  <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder>
      <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="STDERR"/>
  </root>
</configuration>
